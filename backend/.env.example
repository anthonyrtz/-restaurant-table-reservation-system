# Copy this file to .env and fill in real values. Never commit .env itself.

# XAMPP MySQL defaults — change if you set a root password in phpMyAdmin
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=restaurant_reservation_db

# Use a long random string in your real .env — this is just a placeholder
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h

PORT=3000
